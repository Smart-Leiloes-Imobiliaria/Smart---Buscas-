DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/morada
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Sessão de autenticação. Em produção, gere uma chave longa e aleatória.
AUTH_SESSION_SECRET=
# Usado somente uma vez por `npm run auth:seed-admin`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Em Cloud Run, use o socket anexado pelo Cloud SQL e forneça DB_PASSWORD pelo
# Secret Manager. Não combine INSTANCE_UNIX_SOCKET com DATABASE_URL.
# INSTANCE_UNIX_SOCKET=/cloudsql/projeto:regiao:instancia
# DB_NAME=morada
# DB_USER=morada_app
# DB_PASSWORD=
# DB_PORT=5432

# Serviço privado de coleta autorizado, hospedado no Cloud Run.
# Sem esta URL, os conectores usam dados demonstrativos locais.
PORTAL_DATA_API_URL=
PORTAL_DATA_API_TOKEN=
PORTAL_DATA_SOURCES=zap,vivareal,imovelweb,casamineira,quintoandar
PORTAL_DATA_TIMEOUT_MS=10000

# Coleta periódica de páginas públicas. Copie o exemplo, revise os seletores e
# use somente domínios onde a coleta automatizada esteja permitida.
# COLLECTOR_CONFIG_PATH=./config/collector.json
COLLECTOR_MISS_THRESHOLD=3
COLLECTOR_INACTIVE_AFTER_HOURS=36

# Pesquisas sob demanda. No desenvolvimento, o worker lê diretamente a fila
# PostgreSQL com `npm run collector:worker`.
PROPERTY_SEARCH_CACHE_MINUTES=10
PROPERTY_SEARCH_DISPATCH_MODE=database
COLLECTOR_POLL_INTERVAL=2
COLLECTOR_HEADLESS=false
COLLECTOR_SOURCES=MONGO,VIVAREAL,QUINTOANDAR,LOPES,CHAVESNAMAO
COLLECTOR_PAGE_TIMEOUT_SECONDS=30
COLLECTOR_SCRIPT_TIMEOUT_SECONDS=15
COLLECTOR_ELEMENT_TIMEOUT_SECONDS=15
COLLECTOR_JOB_TIMEOUT_SECONDS=180
COLLECTOR_MAX_ATTEMPTS=3
COLLECTOR_RETRY_BASE_SECONDS=5
COLLECTOR_RETRY_MAX_SECONDS=60
COLLECTOR_BLOCK_RETRY_SECONDS=120
COLLECTOR_HEARTBEAT_INTERVAL_SECONDS=15
COLLECTOR_STALE_AFTER_SECONDS=300

# Fonte adicional de imóveis já armazenados no MongoDB. Deixe MONGODB_URI vazio
# para desativar esta fonte sem afetar a coleta dos portais.
MONGODB_URI=
MONGODB_DATABASE=smart_app
MONGODB_PROPERTIES_COLLECTION=imoveis
MONGODB_TIMEOUT_MS=10000
MONGODB_CANDIDATE_LIMIT=80

# Em produção, use Cloud Tasks para chamar o serviço privado do coletor.
PROPERTY_SEARCH_CACHE_MINUTES=10
PROPERTY_SEARCH_ACTIVE_STALE_MINUTES=15
# PROPERTY_SEARCH_DISPATCH_MODE=cloud-tasks
# CLOUD_TASKS_LOCATION=southamerica-east1
# CLOUD_TASKS_QUEUE=property-searches
# PROPERTY_COLLECTOR_SERVICE_URL=https://property-collector-xxxxx.run.app
# CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=property-search-dispatcher@PROJECT_ID.iam.gserviceaccount.com

# Vertex AI Search / Smart-Buscas. A autenticação usa Application Default Credentials.
# Na Vercel, configure GOOGLE_CREDENTIALS_JSON com o JSON da service account.
GOOGLE_CLOUD_PROJECT=smart-caixa-teste
GOOGLE_CREDENTIALS_JSON=
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_COLLECTION=default_collection
DISCOVERY_ENGINE_DATA_STORE_ID=smart-dados-pesquisa_1786716693643
DISCOVERY_ENGINE_ENGINE_ID=smart-buscas_1786716455197
DISCOVERY_ENGINE_BRANCH=default_branch
DISCOVERY_ENGINE_SCHEMA_ID=default_schema
DISCOVERY_ENGINE_TIMEOUT_MS=15000
# Ative somente quando o gateway estiver entregando anúncios reais.
SEARCH_INDEX_ENABLED=false

# Vercel / Next.js
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_POOL_MAX=5
DATABASE_SSL=true
AUTH_SESSION_SECRET=GENERATE_A_LONG_RANDOM_SECRET

# Authorized portal gateway. Keep blank unless you have a contracted feed/API.
PORTAL_DATA_API_URL=
PORTAL_DATA_API_TOKEN=
PORTAL_DATA_SOURCES=zap,vivareal,imovelweb,casamineira,quintoandar
PORTAL_DATA_TIMEOUT_MS=10000

# On-demand property search dispatch from Vercel to Cloud Tasks.
PROPERTY_SEARCH_CACHE_MINUTES=10
PROPERTY_SEARCH_ACTIVE_STALE_MINUTES=15
PROPERTY_SEARCH_DISPATCH_MODE=cloud-tasks
GOOGLE_CLOUD_PROJECT=smart-caixa-teste
CLOUD_TASKS_LOCATION=southamerica-east1
CLOUD_TASKS_QUEUE=property-searches
PROPERTY_COLLECTOR_SERVICE_URL=https://property-collector-37ra7wuzda-rj.a.run.app
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=property-search-dispatcher@smart-caixa-teste.iam.gserviceaccount.com
# Obrigatório na Vercel para Cloud Tasks/Vertex AI Search, salvo como secret.
GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"smart-caixa-teste",...}

# Vertex AI Search / Smart-Buscas. Enable only after real listings are flowing.
DISCOVERY_ENGINE_LOCATION=global
DISCOVERY_ENGINE_COLLECTION=default_collection
DISCOVERY_ENGINE_DATA_STORE_ID=smart-dados-pesquisa_1786716693643
DISCOVERY_ENGINE_ENGINE_ID=smart-buscas_1786716455197
DISCOVERY_ENGINE_BRANCH=default_branch
DISCOVERY_ENGINE_SCHEMA_ID=default_schema
DISCOVERY_ENGINE_TIMEOUT_MS=15000
SEARCH_INDEX_ENABLED=false

{
  "name": "imobiliaria-smart-leiloes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:collector": ".venv/bin/python -m unittest discover -s scripts/collector-python/tests -t scripts/collector-python -v",
    "test:e2e": "playwright test",
    "db:start": "bash scripts/postgres-local.sh start",
    "db:stop": "bash scripts/postgres-local.sh stop",
    "db:status": "bash scripts/postgres-local.sh status",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed-demo.ts",
    "collect": "node --env-file-if-exists=.env.local --import tsx scripts/collect.ts",
    "collector:worker": "set -a && . ./.env.local && set +a && .venv/bin/python scripts/collector-python/worker.py",
    "collector:once": "set -a && . ./.env.local && set +a && .venv/bin/python scripts/collector-python/worker.py --once",
    "search:schema": "tsx scripts/update-search-schema.ts"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "google-auth-library": "^10.9.1",
    "next": "16.3.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^4.0.0"
  }
}
